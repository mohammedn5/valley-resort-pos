# ============================================================
# متغيرات البيئة - نظام منتجع فالي
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية قبل التشغيل
# ============================================================

# رابط الاتصال بقاعدة بيانات PostgreSQL
# صيغة: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/valley_resort?schema=public"

# مفتاح توقيع جلسات تسجيل الدخول (JWT) - يجب أن يكون نصاً عشوائياً طويلاً
# ولا يقل عن 32 حرفاً. لا تشارك هذه القيمة أو ترفعها لأي مستودع عام.
# يمكن توليد قيمة عشوائية عبر: openssl rand -base64 32
SESSION_SECRET="ضع-هنا-نصاً-عشوائياً-طويلاً-لا-يقل-عن-32-حرفاً"

# بيئة التشغيل (development | production)
NODE_ENV="development"
